diff --git a/site/build/sitemap_tool.py b/site/build/sitemap_tool.py
new file mode 100644
index 0000000..fb87e63
--- /dev/null
+++ b/site/build/sitemap_tool.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""
+Sitemap generator + validator for the DEPLOYED site (repo root).
+
+The deployed root has diverged from what site/build/pages.py would regenerate
+(hand-edited titles, a different /calligraphy-editor/ page), so re-running the
+generator would overwrite live content. This tool therefore builds sitemap.xml
+from the pages that actually exist on disk instead of from a hard-coded list.
+
+  python3 site/build/sitemap_tool.py            # write sitemap.xml (repo root)
+  python3 site/build/sitemap_tool.py --check    # validate only, exit 1 on problems
+  python3 site/build/sitemap_tool.py --root DIR # operate on another site root
+
+Rules:
+  * A page is a top-level folder containing index.html (plus "/" for the root).
+  * Pages with <meta name="robots" content="...noindex..."> are excluded.
+  * assets/, site/, vendor/, hidden folders and non-page folders are ignored.
+  * Every <loc> is SITE_ORIGIN + route, with a trailing slash (folder URLs).
+  * No <lastmod> is written: there is no reliable per-page modification date.
+"""
+import argparse
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+SITE_ORIGIN = "https://www.arabic-keyboard.live"
+NS = "http://www.sitemaps.org/schemas/sitemap/0.9"
+SKIP_DIRS = {"assets", "site", "node_modules", "vendor", "js", "css", "fonts", "build", "dist"}
+# Routes that must never be listed (removed from the site).
+FORBIDDEN_ROUTES = {"/calligraphy/"}
+
+NOINDEX_RE = re.compile(r'<meta[^>]+name=["\']robots["\'][^>]*content=["\'][^"\']*noindex', re.I)
+CANON_RE = re.compile(r'<link[^>]+rel=["\']canonical["\'][^>]*href=["\']([^"\']+)["\']', re.I)
+
+
+def read(path):
+    with open(path, encoding="utf-8", errors="replace") as f:
+        return f.read()
+
+
+def discover(root):
+    """Return (indexable_routes, noindex_routes), home first, then alphabetical."""
+    found, noindex = [], []
+    if os.path.isfile(os.path.join(root, "index.html")):
+        (noindex if NOINDEX_RE.search(read(os.path.join(root, "index.html"))) else found).append("/")
+    for name in sorted(os.listdir(root)):
+        d = os.path.join(root, name)
+        if name.startswith(".") or name in SKIP_DIRS or not os.path.isdir(d):
+            continue
+        idx = os.path.join(d, "index.html")
+        if os.path.isfile(idx):
+            route = f"/{name}/"
+            (noindex if NOINDEX_RE.search(read(idx)) else found).append(route)
+    return found, noindex
+
+
+def build_xml(routes):
+    lines = ['<?xml version="1.0" encoding="UTF-8"?>', f'<urlset xmlns="{NS}">']
+    lines += [f"  <url><loc>{SITE_ORIGIN}{r}</loc></url>" for r in routes]
+    lines.append("</urlset>")
+    return "\n".join(lines) + "\n"
+
+
+def check(root):
+    problems = []
+    sm = os.path.join(root, "sitemap.xml")
+    if not os.path.isfile(sm):
+        return ["sitemap.xml missing"]
+    try:
+        tree = ET.parse(sm)
+    except ET.ParseError as e:
+        return [f"sitemap.xml is not valid XML: {e}"]
+    locs = [e.text.strip() for e in tree.getroot().iter(f"{{{NS}}}loc")]
+    if tree.getroot().tag != f"{{{NS}}}urlset":
+        problems.append("root element is not sitemap <urlset>")
+    if len(locs) != len(set(locs)):
+        problems.append("duplicate <loc> entries: " + ", ".join(sorted({l for l in locs if locs.count(l) > 1})))
+    expected, noindex = discover(root)
+    for loc in locs:
+        if "example.com" in loc:
+            problems.append(f"placeholder domain: {loc}")
+        if not loc.startswith(SITE_ORIGIN + "/"):
+            problems.append(f"wrong origin: {loc}")
+            continue
+        route = loc[len(SITE_ORIGIN):]
+        if route in FORBIDDEN_ROUTES:
+            problems.append(f"removed route listed: {loc}")
+        if route != "/" and not route.endswith("/"):
+            problems.append(f"missing trailing slash: {loc}")
+        page = os.path.join(root, route.strip("/"), "index.html")
+        if not os.path.isfile(page):
+            problems.append(f"no such page on disk: {loc}")
+        elif route in noindex:
+            problems.append(f"page is noindex: {loc}")
+        else:
+            m = CANON_RE.search(read(page))
+            if m and m.group(1) != loc:
+                problems.append(f"canonical mismatch for {loc}: {m.group(1)}")
+    for r in expected:
+        if SITE_ORIGIN + r not in locs:
+            problems.append(f"indexable page missing from sitemap: {r}")
+    rb = os.path.join(root, "robots.txt")
+    if not os.path.isfile(rb):
+        problems.append("robots.txt missing")
+    else:
+        sm_lines = [l.split(":", 1)[1].strip() for l in read(rb).splitlines() if l.lower().startswith("sitemap:")]
+        if sm_lines != [SITE_ORIGIN + "/sitemap.xml"]:
+            problems.append(f"robots.txt Sitemap line(s) wrong: {sm_lines}")
+    return problems
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
+    ap.add_argument("--check", action="store_true")
+    a = ap.parse_args()
+    root = os.path.abspath(a.root)
+    if not a.check:
+        routes, noindex = discover(root)
+        with open(os.path.join(root, "sitemap.xml"), "w", encoding="utf-8", newline="\n") as f:
+            f.write(build_xml(routes))
+        print(f"wrote sitemap.xml with {len(routes)} URLs; excluded noindex: {noindex or 'none'}")
+    problems = check(root)
+    for p in problems:
+        print("PROBLEM:", p)
+    print("OK" if not problems else f"{len(problems)} problem(s)")
+    sys.exit(1 if problems else 0)
+
+
+if __name__ == "__main__":
+    main()
